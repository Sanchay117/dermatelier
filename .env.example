# Your YouCam API Bearer Key (redeemed 1,000-unit hackathon key)
YOUCAM_API_KEY=

# YouCam S2S v2.0 Base Cluster URL
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Unit-Shield Safety Governance:
# Maximum live API units allowed to be consumed before requiring confirmation.
# Protects your 1,000-unit hackathon allocation from accidental loops/reloads.
# SHA-256 content-addressed cache hits ALWAYS consume 0 units.
YOUCAM_MAX_BUDGET_UNITS=150

# Total redeemed balance (displayed in the live Unit-Shield telemetry header)
YOUCAM_TOTAL_REDEEMED_UNITS=1000

# Poll configuration (milliseconds)
YOUCAM_POLL_INTERVAL_MS=2000
YOUCAM_POLL_TIMEOUT_MS=45000

# Optional: Deepgram Aura-2 Neural TTS Key for Studio Clinical Audio Briefings
# (Automatically falls back to browser Web Speech API if omitted)
DEEPGRAM_API_KEY=
